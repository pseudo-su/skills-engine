#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  scripts/link init [--no-discover] [--no-sync]

  scripts/link dest discover [--add]
  scripts/link dest add DIRECTORY [--no-sync]
  scripts/link dest remove DIRECTORY
  scripts/link dest status

  scripts/link sync [--dry-run] [--clear]
  scripts/link sync status

  scripts/link status
  scripts/link -h|--help

Manage skill-link destinations and synchronize authored skills from this checkout.
EOF
}

fail() {
  printf 'link: %s\n' "$*" >&2
  exit 2
}

command=''
destination_action=''
destination_arg=''
add_discovered=false
clear_mode=false
dry_run=false
no_discover=false
no_sync=false

repository_root=''
skills_root=''
state_directory=''
destinations_file=''

declare -a connected_destinations=()
declare -a discovered_destinations=()
declare -A skill_sources=()
declare -a skill_names=()

declare -a plan_destinations=()
declare -a plan_destination_exists=()
declare -a temporary_files=()
temporary_file=''

parse_arguments() {
  if (($# == 0)); then
    usage >&2
    exit 2
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    init)
      command=init
      shift
      parse_init_arguments "$@"
      ;;
    dest)
      command=dest
      shift
      parse_destination_arguments "$@"
      ;;
    sync)
      command=sync
      shift
      parse_sync_arguments "$@"
      ;;
    status)
      command=status
      shift
      (($# == 0)) || fail 'status does not accept arguments'
      ;;
    *)
      fail "unknown command: $1"
      ;;
  esac
}

parse_init_arguments() {
  while (($#)); do
    case "$1" in
      --no-discover) no_discover=true ;;
      --no-sync) no_sync=true ;;
      *) fail "unknown option for init: $1" ;;
    esac
    shift
  done
}

parse_destination_arguments() {
  (($#)) || fail 'dest requires an action'
  destination_action=$1
  shift

  case "$destination_action" in
    discover)
      while (($#)); do
        case "$1" in
          --add) add_discovered=true ;;
          *) fail "unknown option for dest discover: $1" ;;
        esac
        shift
      done
      ;;
    add)
      (($#)) || fail 'dest add requires a directory'
      destination_arg=$1
      shift
      while (($#)); do
        case "$1" in
          --no-sync) no_sync=true ;;
          *) fail "unknown option for dest add: $1" ;;
        esac
        shift
      done
      ;;
    remove)
      (($# == 1)) || fail 'dest remove requires exactly one directory'
      destination_arg=$1
      ;;
    status)
      (($# == 0)) || fail 'dest status does not accept arguments'
      ;;
    *)
      fail "unknown dest action: $destination_action"
      ;;
  esac
}

parse_sync_arguments() {
  if (($#)) && [[ "$1" == status ]]; then
    (($# == 1)) || fail 'sync status does not accept arguments'
    command=sync-status
    return
  fi

  while (($#)); do
    case "$1" in
      --dry-run) dry_run=true ;;
      --clear) clear_mode=true ;;
      *) fail "unknown option for sync: $1" ;;
    esac
    shift
  done
}

resolve_checkout_paths() {
  local script_directory

  script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  repository_root=$(realpath -m -- "$script_directory/..")
  skills_root=$(realpath -m -- "$repository_root/skills")
  state_directory=$repository_root/.state
  destinations_file=$state_directory/link-destinations
}

normalize_destination() {
  realpath -m -- "$1" || fail "invalid destination: $1"
}

validate_destination_identity() {
  local requested=$1

  if [[ -e "$requested" || -L "$requested" ]]; then
    [[ -d "$requested" ]] || fail "destination is not a directory: $requested"
  fi
}

cleanup_temporary_files() {
  ((${#temporary_files[@]})) && rm -f -- "${temporary_files[@]}"
}

make_temporary_file() {
  local prefix=$1

  temporary_file=$(mktemp "${TMPDIR:-/tmp}/$prefix.XXXXXX") || fail 'cannot create temporary file'
  temporary_files+=("$temporary_file")
}

initialize_state() {
  mkdir -p -- "$state_directory"
  [[ -f "$destinations_file" ]] || : >"$destinations_file"
}

load_connected_destinations() {
  [[ -f "$destinations_file" ]] || return 0
  mapfile -d '' -t connected_destinations <"$destinations_file"
}

is_connected() {
  local candidate=$1 connected

  for connected in "${connected_destinations[@]}"; do
    [[ "$connected" == "$candidate" ]] && return 0
  done
  return 1
}

write_connected_destinations() {
  local registry_update

  initialize_state
  registry_update=$(mktemp "$state_directory/link-destinations.XXXXXX") || fail 'cannot create destination registry update'
  temporary_files+=("$registry_update")
  if ((${#connected_destinations[@]})); then
    printf '%s\0' "${connected_destinations[@]}" | sort -zu >"$registry_update"
  fi
  mv -- "$registry_update" "$destinations_file"
}

add_destination_state() {
  local candidate=$1

  if is_connected "$candidate"; then
    printf 'Destination already added: %s\n' "$candidate"
    return 1
  fi

  connected_destinations+=("$candidate")
  write_connected_destinations
  printf 'Added destination: %s\n' "$candidate"
  return 0
}

remove_destination_state() {
  local candidate=$1 connected
  local -a retained=()

  is_connected "$candidate" || fail "destination is not added: $candidate"
  for connected in "${connected_destinations[@]}"; do
    [[ "$connected" == "$candidate" ]] || retained+=("$connected")
  done
  connected_destinations=("${retained[@]}")
  write_connected_destinations
  printf 'Removed destination: %s\n' "$candidate"
}

discover_well_known_destinations() {
  local candidate
  local -a candidates=(
    "${HOME:?}/.pi/agent/skills"
    "${HOME:?}/.oh-omp/agent/skills"
    "${HOME:?}/.claude/skills"
    "${HOME:?}/.codex/skills"
    "${HOME:?}/.copilot/skills"
    "${HOME:?}/.config/devin/skills"
    "${HOME:?}/.factory/skills"
    "${HOME:?}/.kimi/skills"
    "${HOME:?}/.config/opencode/skills"
    "${HOME:?}/.kilo/skills"
    "${HOME:?}/.hermes/skills"
    "${HOME:?}/.qoder/skills"
    "${HOME:?}/.qwen/skills"
    "${HOME:?}/.cursor/skills"
    "${HOME:?}/.mastracode/skills"
    "${HOME:?}/.gemini/config/skills"
    "${HOME:?}/.gemini/antigravity-cli/skills"
    "${HOME:?}/.grok/skills"
  )

  discovered_destinations=()
  for candidate in "${candidates[@]}"; do
    candidate=$(normalize_destination "$candidate")
    [[ -d "$candidate" ]] || continue
    discovered_destinations+=("$candidate")
    printf 'Discovered destination: %s\n' "$candidate"
  done
}

discover_skills() {
  local manifest_list skill_name_list manifest source_directory name

  make_temporary_file skills-link-manifests
  manifest_list=$temporary_file
  if ! find "$skills_root" -type f -name SKILL.md -print0 | sort -z >"$manifest_list"; then
    fail "skill discovery failed below $skills_root"
  fi
  [[ -s "$manifest_list" ]] || fail "no skills found below $skills_root"

  while IFS= read -r -d '' manifest; do
    source_directory=$(realpath -m -- "$(dirname -- "$manifest")")
    name=${source_directory##*/}
    if [[ -v "skill_sources[$name]" ]]; then
      fail "duplicate skill name '$name': ${skill_sources[$name]} and $source_directory"
    fi
    skill_sources["$name"]=$source_directory
  done <"$manifest_list"

  make_temporary_file skills-link-names
  skill_name_list=$temporary_file
  if ! printf '%s\0' "${!skill_sources[@]}" | sort -z >"$skill_name_list"; then
    fail 'skill-name sorting failed'
  fi
  mapfile -d '' -t skill_names <"$skill_name_list"
}

validate_destination_for_sync() {
  local requested=$1 existing_ancestor parent

  if [[ -e "$requested" || -L "$requested" ]]; then
    [[ -d "$requested" ]] || fail "destination is not a directory: $requested"
    return
  fi

  existing_ancestor=$requested
  while [[ ! -e "$existing_ancestor" && ! -L "$existing_ancestor" ]]; do
    parent=$(dirname -- "$existing_ancestor")
    [[ "$parent" != "$existing_ancestor" ]] || break
    existing_ancestor=$parent
  done
  [[ -d "$existing_ancestor" ]] || fail "destination cannot be created below a non-directory: $requested"
  [[ -w "$existing_ancestor" ]] || fail "destination cannot be created below an unwritable directory: $requested"
}

# Resolve the link's stored target lexically. Existing symlink components are
# not followed, and the target does not need to exist.
normalize_link_target() {
  local link_path=$1 target

  target=$(readlink -- "$link_path")
  if [[ "$target" = /* ]]; then
    realpath -ms -- "$target"
  else
    realpath -ms -- "$(dirname -- "$link_path")/$target"
  fi
}

create_plan_storage() {
  local index=$1
  declare -g -a "plan_current_$index=()"
  declare -g -a "plan_remove_$index=()"
  declare -g -a "plan_link_$index=()"
  declare -g -a "plan_missing_$index=()"
  declare -g -a "plan_retarget_$index=()"
  declare -g -a "plan_stale_$index=()"
  declare -g -a "plan_conflict_$index=()"
}

plan_destination() {
  local requested=$1 mode=$2 index link_list link_path target name desired_path
  local exists=false
  local -A owned_targets=()
  local -a owned_names=()

  requested=$(normalize_destination "$requested")
  if [[ -e "$requested" || -L "$requested" ]]; then
    [[ -d "$requested" ]] || fail "destination is not a directory: $requested"
    exists=true
  elif [[ "$mode" == sync ]]; then
    validate_destination_for_sync "$requested"
  fi

  index=${#plan_destinations[@]}
  plan_destinations+=("$requested")
  plan_destination_exists+=("$exists")
  create_plan_storage "$index"

  local -n current="plan_current_$index"
  local -n removals="plan_remove_$index"
  local -n links="plan_link_$index"
  local -n missing="plan_missing_$index"
  local -n retarget="plan_retarget_$index"
  local -n stale="plan_stale_$index"
  local -n conflicts="plan_conflict_$index"

  if "$exists"; then
    make_temporary_file skills-link-destination
    link_list=$temporary_file
    if ! find "$requested" -mindepth 1 -maxdepth 1 -type l -print0 | sort -z >"$link_list"; then
      fail "destination link discovery failed below $requested"
    fi
    while IFS= read -r -d '' link_path; do
      target=$(normalize_link_target "$link_path")
      [[ "$target" == "$skills_root/"* ]] || continue
      name=${link_path##*/}
      owned_names+=("$name")
      owned_targets["$name"]=$target
    done <"$link_list"
  fi

  if [[ "$mode" == clear ]]; then
    for name in "${owned_names[@]}"; do
      removals+=("$requested/$name")
    done
    return
  fi

  for name in "${skill_names[@]}"; do
    desired_path=$requested/$name
    if [[ -v "owned_targets[$name]" ]]; then
      if [[ "${owned_targets[$name]}" == "${skill_sources[$name]}" ]]; then
        current+=("$name")
      else
        removals+=("$desired_path")
        links+=("$name")
        retarget+=("$name")
      fi
    elif [[ -e "$desired_path" || -L "$desired_path" ]]; then
      conflicts+=("$desired_path")
    else
      links+=("$name")
      missing+=("$name")
    fi
  done

  for name in "${owned_names[@]}"; do
    if [[ ! -v "skill_sources[$name]" ]]; then
      removals+=("$requested/$name")
      stale+=("$name")
    fi
  done
}

plan_destinations() {
  local mode=$1 destination
  shift

  plan_destinations=()
  plan_destination_exists=()
  for destination in "$@"; do
    plan_destination "$destination" "$mode"
  done
}

reject_planned_conflicts() {
  local index path found=false

  for index in "${!plan_destinations[@]}"; do
    local -n conflicts="plan_conflict_$index"
    for path in "${conflicts[@]}"; do
      printf 'link: occupied desired path: %s\n' "$path" >&2
      found=true
    done
  done
  if "$found"; then
    exit 2
  fi
  return 0
}

report_plan() {
  local index=$1 destination=${plan_destinations[$1]} path name
  local -n current="plan_current_$index"
  local -n removals="plan_remove_$index"
  local -n links="plan_link_$index"

  for name in "${current[@]}"; do
    printf 'Already linked: %s\n' "$destination/$name"
  done
  for path in "${removals[@]}"; do
    printf 'Would remove: %s\n' "$path"
  done
  for name in "${links[@]}"; do
    printf 'Would link: %s -> %s\n' "$destination/$name" "${skill_sources[$name]}"
  done
}

apply_plan() {
  local index=$1 destination=${plan_destinations[$1]} path name
  local -n current="plan_current_$index"
  local -n removals="plan_remove_$index"
  local -n links="plan_link_$index"

  for name in "${current[@]}"; do
    printf 'Already linked: %s\n' "$destination/$name"
  done
  if ((${#links[@]})) && [[ "${plan_destination_exists[$index]}" == false ]]; then
    mkdir -p -- "$destination"
  fi
  for path in "${removals[@]}"; do
    printf 'Remove: %s\n' "$path"
    unlink -- "$path"
  done
  for name in "${links[@]}"; do
    printf 'Link: %s -> %s\n' "$destination/$name" "${skill_sources[$name]}"
    ln -s -- "${skill_sources[$name]}" "$destination/$name"
  done
}

apply_all_plans() {
  local index
  for index in "${!plan_destinations[@]}"; do
    if "$dry_run"; then
      report_plan "$index"
    else
      apply_plan "$index"
    fi
  done
}

report_destination_status() {
  local destination

  if ((${#connected_destinations[@]} == 0)); then
    printf 'No destinations added.\n'
    return
  fi
  for destination in "${connected_destinations[@]}"; do
    if [[ -d "$destination" ]]; then
      printf 'Destination: %s (present)\n' "$destination"
    elif [[ -e "$destination" || -L "$destination" ]]; then
      printf 'Destination: %s (not a directory)\n' "$destination"
    else
      printf 'Destination: %s (missing)\n' "$destination"
    fi
  done
}

report_sync_status() {
  local index destination name path

  if ((${#connected_destinations[@]} == 0)); then
    printf 'No destinations added.\n'
    return
  fi

  discover_skills
  plan_destinations status "${connected_destinations[@]}"
  for index in "${!plan_destinations[@]}"; do
    destination=${plan_destinations[$index]}
    local -n current="plan_current_$index"
    local -n missing="plan_missing_$index"
    local -n retarget="plan_retarget_$index"
    local -n stale="plan_stale_$index"
    local -n conflicts="plan_conflict_$index"

    printf 'Destination: %s\n' "$destination"
    [[ "${plan_destination_exists[$index]}" == true ]] \
      && printf '  State: present\n' \
      || printf '  State: missing\n'
    for name in "${current[@]}"; do printf '  Current: %s\n' "$name"; done
    for name in "${missing[@]}"; do printf '  Missing: %s\n' "$name"; done
    for name in "${retarget[@]}"; do printf '  Retarget: %s\n' "$name"; done
    for name in "${stale[@]}"; do printf '  Stale: %s\n' "$name"; done
    for path in "${conflicts[@]}"; do printf '  Conflict: %s\n' "${path##*/}"; done
  done
}

run_sync() {
  local mode=sync

  if ((${#connected_destinations[@]} == 0)); then
    printf 'No destinations added.\n'
    return
  fi
  if "$clear_mode"; then
    mode=clear
  else
    discover_skills
  fi
  plan_destinations "$mode" "${connected_destinations[@]}"
  [[ "$mode" == clear ]] || reject_planned_conflicts
  apply_all_plans
}

run_destination_discovery() {
  local destination
  local -a newly_added=()

  discover_well_known_destinations
  if ! "$add_discovered"; then
    return 0
  fi

  for destination in "${discovered_destinations[@]}"; do
    if ! is_connected "$destination"; then
      connected_destinations+=("$destination")
      newly_added+=("$destination")
      printf 'Added destination: %s\n' "$destination"
    fi
  done
  if ((${#newly_added[@]} == 0)); then
    return 0
  fi
  write_connected_destinations

  discover_skills
  plan_destinations sync "${newly_added[@]}"
  reject_planned_conflicts
  apply_all_plans
}

run_destination_add() {
  local destination already_connected=false

  destination=$(normalize_destination "$destination_arg")
  validate_destination_identity "$destination"
  is_connected "$destination" && already_connected=true

  if "$no_sync"; then
    add_destination_state "$destination" || true
    return
  fi

  discover_skills
  plan_destinations sync "$destination"
  reject_planned_conflicts
  if "$already_connected"; then
    printf 'Destination already added: %s\n' "$destination"
  else
    connected_destinations+=("$destination")
    write_connected_destinations
    printf 'Added destination: %s\n' "$destination"
  fi
  apply_all_plans
}

run_destination_remove() {
  local destination

  destination=$(normalize_destination "$destination_arg")
  is_connected "$destination" || fail "destination is not added: $destination_arg"
  plan_destinations clear "$destination"
  apply_all_plans
  remove_destination_state "$destination"
}

run_init() {
  local destination

  initialize_state
  if ! "$no_discover"; then
    discover_well_known_destinations
    for destination in "${discovered_destinations[@]}"; do
      if ! is_connected "$destination"; then
        connected_destinations+=("$destination")
        printf 'Added destination: %s\n' "$destination"
      fi
    done
    write_connected_destinations
  fi
  "$no_sync" || run_sync
}

run_combined_status() {
  report_destination_status
  ((${#connected_destinations[@]})) && report_sync_status
  return 0
}

main() {
  parse_arguments "$@"
  resolve_checkout_paths
  trap cleanup_temporary_files EXIT
  load_connected_destinations

  case "$command" in
    init) run_init ;;
    dest)
      case "$destination_action" in
        discover) run_destination_discovery ;;
        add) run_destination_add ;;
        remove) run_destination_remove ;;
        status) report_destination_status ;;
      esac
      ;;
    sync) run_sync ;;
    sync-status) report_sync_status ;;
    status) run_combined_status ;;
  esac
}

main "$@"
